# Copy to .env.local for local development. Never commit real values.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (resend.com). Without a verified domain, Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM=Cairn <cairn@your-domain.com>

# Anthropic API key, for the monthly guide check (console.anthropic.com)
ANTHROPIC_API_KEY=

# A long random string. Vercel sends it with each scheduled job.
CRON_SECRET=

# The only email address allowed on the /review screen
ADMIN_EMAIL=

# Optional: the public address, used in emails (defaults to the request's own address)
NEXT_PUBLIC_SITE_URL=
